{
  "name": "Claude Code Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "runArgs": ["--shm-size=2g"],
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-python.pylint"] }
  },
  "remoteUser": "vscode"//,
    // make the workspace bind mount explicit and add a consistency hint
  //"workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/active-statics,type=bind,consistency=delegated",
  //"workspaceFolder": "/workspaces/active-statics"
}
